{
  "name": "@criogaid/pi-hashline-edit",
  "version": "0.6.1",
  "type": "module",
  "description": "Hashline-style file editing for pi — line-anchored edits verified by content hash, replacing oldText/newText matching",
  "homepage": "https://github.com/Criogaid/pi-hashline-edit#readme",
  "bugs": {
    "url": "https://github.com/Criogaid/pi-hashline-edit/issues"
  },
  "keywords": [
    "pi-package",
    "pi"
  ],
  "main": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "biome format --write src/ bench/",
    "format:check": "biome format src/ bench/",
    "typecheck": "tsc --noEmit",
    "test": "node src/testing/run-tests.ts unit",
    "test:integration": "node src/testing/run-tests.ts integration",
    "test:all": "npm test && npm run test:integration",
    "bench": "node bench/throughput.bench.ts"
  },
  "dependencies": {
    "@vscode/ripgrep": "1.18.0",
    "jiti": "2.7.0",
    "typebox": "1.3.34"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@earendil-works/pi-agent-core": "0.99.1",
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Criogaid/pi-hashline-edit.git"
  },
  "license": "MIT"
}
