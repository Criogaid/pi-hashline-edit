{
  "name": "@criogaid/pi-hashline-edit",
  "version": "0.1.2",
  "type": "module",
  "description": "Hashline-style file editing for pi — line-anchored edits verified by content hash, replacing oldText/newText matching",
  "homepage": "https://github.com/Criogaid/pi-hashline-edit#readme",
  "bugs": {
    "url": "https://github.com/Criogaid/pi-hashline-edit/issues"
  },
  "keywords": [
    "pi-package",
    "pi"
  ],
  "main": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test src/core/*.test.ts src/pi/*.test.ts",
    "test:integration": "node --test src/integration/*.test.ts",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "@vscode/ripgrep": "1.18.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "^1.1.38",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Criogaid/pi-hashline-edit.git"
  },
  "license": "MIT"
}
